{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(scripts/new-project.sh:*)",
      "Bash(scripts/test-all.sh)",
      "Bash(npm test:*)",
      "Bash(npm start:*)",
      "Bash(python3 -m pytest:*)"
    ]
  }
}
